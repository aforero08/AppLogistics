@model ModuleModel
@using System
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@{
    Layout = null; // This template emits C# class source text – no layout needed
}
namespace AppLogistics.Objects
{
    public class @Model.View : BaseView
    {
@foreach (PropertyInfo property in Model.Properties)
{
@foreach (CustomAttributeData attr in property.CustomAttributes)
{
@:        [@attr.AttributeType.Name.Replace("Attribute", "")]
}
@:        public @property.PropertyType.Name @property.Name { get; set; }
}
    }
}
